                  "key": "q",
                  "value": "1",
                  "description": { "content": "query description, object", "type": "text/html" }
                }
              ]
            },
            "description": {
              "content": "FR-013: request description as an OBJECT",
              "type": "text/markdown"
            }
          },
          "response": []
        },
        {
          "name": "description as NULL, and a description OBJECT with no content",
