{
  "info": {
    "_postman_id": "00000000-dead-4bee-8000-0000000t0rtur",
    "name": "Polymorphism Torture",
    "description": {
      "content": "# Torture fixture\n\nHand-authored. Exercises **every** polymorphic shape in FR-010..FR-013, all five body modes, all eleven auth types, folders nested six deep, unknown fields at every level, and unnamed nodes.\n\nThis file is not a Postman export and never was — see `tests/fixtures/README.md`.",
      "type": "text/markdown"
    },
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0,
      "identifier": "torture"
    },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "00000000",
    "x_minim_unknown_info": "FR-009: unknown field on info"
  },
  "x_minim_unknown_root": {
    "note": "FR-009: unknown field at the collection root",
    "nested": [1, 2, 3]
  },
  "protocolProfileBehavior": {
    "disableBodyPruning": true,
    "x_minim_unknown_ppb": true
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{basic_user}}", "type": "string" },
      { "key": "password", "value": "{{basic_pass}}", "type": "string" }
    ],
    "x_minim_unknown_auth": "FR-009: unknown field on collection auth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "collection-prerequest",
        "type": "text/javascript",
        "exec": [
          "// FR-012: exec as an ARRAY of lines, at collection level",
          "pm.collectionVariables.set('run_id', '1');"
        ],
        "x_minim_unknown_script": "FR-009: unknown field on script"
      },
      "x_minim_unknown_event": "FR-009: unknown field on event"
    },
    {
      "listen": "test",
      "script": {
        "id": "collection-test",
        "type": "text/javascript",
        "exec": "// FR-012: exec as a single STRING, at collection level\npm.test('collection-level test', function () { pm.expect(true).to.be.true; });"
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://api.torture.test", "type": "string" },
    { "key": "basic_user", "value": "alice" },
    {
      "key": "basic_pass",
      "value": "s3cr3t",
      "type": "string",
      "description": "FR-013: description as a STRING on a variable",
      "x_minim_unknown_variable": "FR-009: unknown field on variable"
    },
    {
      "key": "documented",
      "value": "1",
      "description": {
        "content": "FR-013: description as an OBJECT on a variable",
        "type": "text/markdown"
      }
    }
  ],
  "item": [
    {
