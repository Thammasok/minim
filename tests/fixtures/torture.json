    {
      "name": "03 Script shapes (FR-012)",
      "item": [
        {
          "name": "exec as an ARRAY of lines",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/v1/scripts/array" },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["const a = 1;", "const b = 2;", "console.log(a + b);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('array exec', function () {", "  pm.response.to.be.ok;", "});"]
              }
            }
          ],
          "response": []
        },
        {
          "name": "exec as a single STRING",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/v1/scripts/string" },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": "const a = 1;\nconst b = 2;\nconsole.log(a + b);"
              }
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": "pm.test('string exec', () => pm.response.to.be.ok);" }
            }
          ],
          "response": []
        },
        {
          "name": "exec as an EMPTY array, and a script with no exec at all",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/v1/scripts/empty" },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [] } },
            { "listen": "test", "script": { "type": "text/javascript" } }
          ],
          "response": []
        },
        {
          "name": "script loaded from src instead of exec (both url shapes)",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/v1/scripts/src" },
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "src": "https://cdn.torture.test/pre.js" }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "src": {
                  "protocol": "https",
                  "host": ["cdn", "torture", "test"],
                  "path": ["post.js"]
                }
              }
            },
            {
              "listen": "test",
              "disabled": true,
              "script": { "type": "text/javascript", "exec": "// disabled event" }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "04 Description shapes (FR-013)",
      "item": [
        {
          "name": "description as a STRING everywhere it can appear",
          "description": "FR-013: item description as a STRING",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-D", "value": "1", "description": "header description, string" }],
            "url": {
              "raw": "{{base_url}}/v1/desc/string?q=1",
              "host": ["{{base_url}}"],
              "path": ["v1", "desc", "string"],
              "query": [{ "key": "q", "value": "1", "description": "query description, string" }]
            },
            "description": "FR-013: request description as a STRING"
          },
          "response": []
        },
        {
          "name": "description as an OBJECT everywhere it can appear",
          "description": {
            "content": "FR-013: item description as an OBJECT",
            "type": "text/markdown",
            "version": null
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-D",
                "value": "1",
                "description": { "content": "header description, object", "type": "text/plain" }
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "field",
                  "value": "v",
                  "description": { "content": "urlencoded description, object", "type": "text/plain" }
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/v1/desc/object?q=1",
              "host": ["{{base_url}}"],
